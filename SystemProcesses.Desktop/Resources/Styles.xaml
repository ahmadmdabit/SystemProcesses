<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:converters="clr-namespace:SystemProcesses.Desktop.Converters"
    xmlns:mwt="clr-namespace:Microsoft.Windows.Themes;assembly=PresentationFramework.Aero">

    <!--  Thickness Resources  -->
    <Thickness
        x:Key="BorderThickness"
        Bottom="1"
        Left="1"
        Right="1"
        Top="1" />

    <!--  Color Resources  -->
    <Color x:Key="PrimaryColor">#FF00EE00</Color>
    <Color x:Key="SecondaryColor">#FF00AA00</Color>
    <Color x:Key="TertiaryColor">#FF008800</Color>
    <Color x:Key="AccentColor">#FF00EE00</Color>
    <Color x:Key="DarkColor">#FF000000</Color>
    <Color x:Key="LightColor">#FFFFFFFF</Color>
    <Color x:Key="SuccessColor">#FF00AA00</Color>
    <Color x:Key="QuestionColor">#FFEF5D27</Color>
    <Color x:Key="InfoColor">#FF2273DE</Color>
    <Color x:Key="WarningColor">#FFE1AA15</Color>
    <Color x:Key="ErrorColor">#FFAF002F</Color>
    <Color x:Key="PanelColor">#FF1E1E1E</Color>
    <Color x:Key="FragmentColor">#FF333333</Color>
    <Color x:Key="FragmentBorderColor">#FF444444</Color>
    <Color x:Key="WidgetColor">#FF212121</Color>
    <Color x:Key="WidgetBorderColor">#FF222222</Color>
    <Color x:Key="BorderColor">#FF3F3F46</Color>
    <Color x:Key="TransparentColor">Transparent</Color>

    <!--  SolidColorBrush Resources  -->
    <SolidColorBrush x:Key="PrimaryBrush" Color="{StaticResource PrimaryColor}" />
    <SolidColorBrush x:Key="SecondaryBrush" Color="{StaticResource SecondaryColor}" />
    <SolidColorBrush x:Key="TertiaryBrush" Color="{StaticResource TertiaryColor}" />
    <SolidColorBrush x:Key="AccentBrush" Color="{StaticResource AccentColor}" />
    <SolidColorBrush x:Key="DarkBrush" Color="{StaticResource DarkColor}" />
    <SolidColorBrush x:Key="LightBrush" Color="{StaticResource LightColor}" />
    <SolidColorBrush x:Key="PanelBrush" Color="{StaticResource PanelColor}" />
    <SolidColorBrush x:Key="BorderBrush" Color="{StaticResource BorderColor}" />
    <SolidColorBrush x:Key="FragmentBrush" Color="{StaticResource FragmentColor}" />
    <SolidColorBrush x:Key="FragmentBorderBrush" Color="{StaticResource FragmentBorderColor}" />
    <SolidColorBrush x:Key="WidgetBrush" Color="{StaticResource WidgetColor}" />
    <SolidColorBrush x:Key="WidgetBorderBrush" Color="{StaticResource WidgetBorderColor}" />
    <SolidColorBrush x:Key="TransparentBrush" Color="{StaticResource TransparentColor}" />

    <!--  Semantic Brush Resources  -->
    <!--  Service icon color (gray for system services)  -->
    <SolidColorBrush x:Key="ServiceIconBrush" Color="{StaticResource SecondaryColor}" />
    <!--  Chevron color for ComboBox toggle button  -->
    <SolidColorBrush x:Key="ChevronBrush" Color="#FF888888" />
    <!--  Text on green accent backgrounds (button/menu hover/pressed states)  -->
    <SolidColorBrush x:Key="ButtonTextOnAccentBrush" Color="{StaticResource DarkColor}" />

    <!--  Status Icon Brushes (for LiteDialog)  -->
    <SolidColorBrush x:Key="SuccessBrush" Color="{StaticResource SuccessColor}" />
    <SolidColorBrush x:Key="QuestionBrush" Color="{StaticResource QuestionColor}" />
    <SolidColorBrush x:Key="InfoBrush" Color="{StaticResource InfoColor}" />
    <SolidColorBrush x:Key="WarningBrush" Color="{StaticResource WarningColor}" />
    <SolidColorBrush x:Key="ErrorBrush" Color="{StaticResource ErrorColor}" />

    <!--  LinearGradientBrushes  -->
    <LinearGradientBrush x:Key="ComboBox.Static.Background" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Offset="0.0" Color="#FFF0F0F0" />
        <GradientStop Offset="1.0" Color="#FFE5E5E5" />
    </LinearGradientBrush>

    <RadialGradientBrush x:Key="IconBorder.Background" Center="0.5,0.5" GradientOrigin="0.5,0.5" RadiusX="0.5" RadiusY="0.5">
        <GradientStop Offset="0.0" Color="#33333333" />
        <GradientStop Offset="1.0" Color="#66006600" />
    </RadialGradientBrush>


    <!--  Converters  -->
    <converters:BytesToAutoFormatConverter x:Key="BytesToAutoFormatConverter" />
    <converters:CpuPercentageConverter x:Key="CpuPercentageConverter" />
    <converters:BoolToBrushConverter
        x:Key="ServiceColorConverter"
        FalseBrush="{StaticResource AccentBrush}"
        TrueBrush="{StaticResource ServiceIconBrush}" />
    <converters:IndentationWidthConverter x:Key="IndentationWidthConverter" />

    <!--  Styles for StatsView  -->
    <Style x:Key="GreenTextBlock" TargetType="TextBlock">
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="HorizontalAlignment" Value="Center" />
        <Setter Property="FontFamily" Value="Consolas" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="FontWeight" Value="Bold" />
        <Setter Property="Foreground" Value="{StaticResource AccentBrush}" />
    </Style>
    <Style
        x:Key="GreenTextBlock2"
        BasedOn="{StaticResource GreenTextBlock}"
        TargetType="TextBlock">
        <Setter Property="FontSize" Value="11" />
        <Setter Property="FontWeight" Value="Normal" />
        <Setter Property="Foreground" Value="{StaticResource AccentBrush}" />
    </Style>

    <Style x:Key="IconBorder" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource FragmentBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource FragmentBorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="5" />
        <Setter Property="MinWidth" Value="50" />
        <Setter Property="Padding" Value="5,3" />
        <Setter Property="Margin" Value="0,0,3,0" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
    </Style>

    <Style x:Key="IconStack" TargetType="StackPanel">
        <Setter Property="HorizontalAlignment" Value="Stretch" />
    </Style>

    <!--  Tray Popup Border  -->
    <Style x:Key="TrayPopupBorderStyle" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource PanelBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource AccentBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="10" />
    </Style>

    <!--  Stat Label TextBlock  -->
    <Style x:Key="StatLabelStyle" TargetType="TextBlock">
        <Setter Property="Margin" Value="0,0,5,0" />
        <Setter Property="FontWeight" Value="Bold" />
    </Style>

    <!--  Tray Popup Header TextBlock  -->
    <Style x:Key="TrayPopupHeaderStyle" TargetType="TextBlock">
        <Setter Property="Margin" Value="0,0,0,5" />
        <Setter Property="FontWeight" Value="Bold" />
        <Setter Property="Foreground" Value="{StaticResource AccentBrush}" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>

    <Style TargetType="TreeView">
        <Setter Property="Background" Value="{StaticResource TransparentBrush}" />
        <Style.Resources>
            <SolidColorBrush x:Key="{x:Static SystemColors.HighlightBrushKey}" Color="Transparent" />
            <SolidColorBrush x:Key="{x:Static SystemColors.HighlightTextBrushKey}" Color="{StaticResource AccentColor}" />
            <SolidColorBrush x:Key="{x:Static SystemColors.InactiveSelectionHighlightBrushKey}" Color="Transparent" />
            <SolidColorBrush x:Key="{x:Static SystemColors.InactiveSelectionHighlightTextBrushKey}" Color="{StaticResource AccentColor}" />
        </Style.Resources>
    </Style>
    <Style x:Key="TreeViewItemStyle" TargetType="TreeViewItem">
        <Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=TwoWay}" />
        <Setter Property="IsSelected" Value="{Binding IsSelected, Mode=TwoWay}" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="Margin" Value="0" />
        <Setter Property="Foreground" Value="{StaticResource SecondaryBrush}" />
        <Setter Property="Background" Value="{StaticResource TransparentBrush}" />
        <Style.Triggers>
            <Trigger Property="IsSelected" Value="True">
                <Setter Property="FontWeight" Value="Bold" />
                <Setter Property="FontSize" Value="17" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <!--  ListBox Style  -->
    <Style TargetType="ListBox">
        <Setter Property="Background" Value="{StaticResource TransparentBrush}" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Foreground" Value="{StaticResource AccentBrush}" />
    </Style>
    <!--  ListBoxItem Style  -->
    <Style x:Key="ListBoxItemStyle" TargetType="ListBoxItem">
        <Setter Property="Padding" Value="8,4" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="BorderBrush" Value="{StaticResource TransparentBrush}" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Margin" Value="0,0,0,2" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ListBoxItem">
                    <Border
                        x:Name="Border"
                        Padding="5"
                        Background="{TemplateBinding Background}"
                        BorderBrush="{TemplateBinding BorderBrush}"
                        BorderThickness="{TemplateBinding BorderThickness}"
                        CornerRadius="6">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Border" Property="Background" Value="{StaticResource AccentBrush}" />
                            <Setter Property="Foreground" Value="{StaticResource ButtonTextOnAccentBrush}" />
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="Border" Property="Background" Value="{StaticResource AccentBrush}" />
                            <Setter Property="Foreground" Value="{StaticResource ButtonTextOnAccentBrush}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!--  Button Styles  -->
    <Style x:Key="ToolbarButtonStyle" TargetType="Button">
        <Setter Property="Margin" Value="5,0" />
        <Setter Property="Padding" Value="10,5" />
        <Setter Property="MinWidth" Value="100" />
    </Style>

    <Style x:Key="ToggleButtonStyle" TargetType="ToggleButton">
        <Setter Property="Margin" Value="5,0" />
        <Setter Property="Padding" Value="10,5" />
        <Setter Property="MinWidth" Value="100" />
    </Style>

    <Style TargetType="Button">
        <Setter Property="Background" Value="{StaticResource PanelBrush}" />
        <Setter Property="Foreground" Value="{StaticResource AccentBrush}" />
        <Setter Property="Padding" Value="20,10" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border
                        x:Name="Border"
                        Padding="5"
                        Background="{TemplateBinding Background}"
                        BorderBrush="{TemplateBinding BorderBrush}"
                        BorderThickness="{TemplateBinding BorderThickness}"
                        CornerRadius="6">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Border" Property="Background" Value="{StaticResource AccentBrush}" />
                            <Setter Property="Foreground" Value="{StaticResource ButtonTextOnAccentBrush}" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Border" Property="Background" Value="{StaticResource AccentBrush}" />
                            <Setter Property="Foreground" Value="{StaticResource ButtonTextOnAccentBrush}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="RoundedButtonDark" TargetType="Button">
        <Setter Property="Background" Value="{StaticResource WidgetBrush}" />
        <Setter Property="Foreground" Value="{StaticResource AccentBrush}" />
        <Setter Property="Padding" Value="20,10" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="BorderBrush" Value="{StaticResource WidgetBorderBrush}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border
                        x:Name="Border"
                        Padding="5"
                        Background="{TemplateBinding Background}"
                        BorderBrush="{TemplateBinding BorderBrush}"
                        BorderThickness="{TemplateBinding BorderThickness}"
                        CornerRadius="6">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Border" Property="Background" Value="{StaticResource DarkBrush}" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Border" Property="Background" Value="{StaticResource BorderBrush}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!--  small chevron toggle template  -->
    <ControlTemplate x:Key="ComboBoxToggleButton" TargetType="ToggleButton">
        <Border
            Padding="4"
            Background="{StaticResource TransparentBrush}"
            CornerRadius="0,6,6,0">
            <Grid
                Width="11"
                Height="11"
                HorizontalAlignment="Center"
                VerticalAlignment="Center">
                <Path
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Data="M 0 0 L 8 0 L 4 5 Z"
                    Fill="{StaticResource ChevronBrush}"
                    Stretch="Uniform" />
            </Grid>
        </Border>
    </ControlTemplate>

    <!--  ContextMenu Style  -->
    <Style x:Key="ContextMenuStyle" TargetType="ContextMenu">
        <Setter Property="OverridesDefaultStyle" Value="True" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="Background" Value="{StaticResource WidgetBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Padding" Value="4" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ContextMenu">
                    <Popup
                        x:Name="Popup"
                        AllowsTransparency="True"
                        Focusable="False"
                        HorizontalOffset="{TemplateBinding HorizontalOffset}"
                        IsOpen="{TemplateBinding IsOpen}"
                        Placement="{TemplateBinding Placement}"
                        PlacementRectangle="{TemplateBinding PlacementRectangle}"
                        PlacementTarget="{TemplateBinding PlacementTarget}"
                        PopupAnimation="Fade"
                        VerticalOffset="{TemplateBinding VerticalOffset}">

                        <Border
                            Padding="{TemplateBinding Padding}"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="8">
                            <ItemsPresenter />
                        </Border>
                    </Popup>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!--  MenuItem Style  -->
    <Style x:Key="MenuItemStyle" TargetType="MenuItem">
        <Setter Property="OverridesDefaultStyle" Value="True" />
        <Setter Property="Foreground" Value="{StaticResource AccentBrush}" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="MenuItem">
                    <Border
                        x:Name="Root"
                        Height="30"
                        Background="{StaticResource TransparentBrush}"
                        CornerRadius="5">
                        <ContentPresenter
                            Margin="8,0,8,0"
                            VerticalAlignment="Center"
                            Content="{TemplateBinding Header}" />
                    </Border>

                    <ControlTemplate.Triggers>
                        <!--  Hover  -->
                        <Trigger Property="IsHighlighted" Value="True">
                            <Setter TargetName="Root" Property="Background" Value="{StaticResource AccentBrush}" />
                            <Setter Property="Foreground" Value="{StaticResource ButtonTextOnAccentBrush}" />
                        </Trigger>

                        <!--  Disabled  -->
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Foreground" Value="{StaticResource SecondaryBrush}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!--  WindowStyle  -->
    <Style x:Key="WindowStyle" TargetType="Window">
        <Setter Property="Background" Value="{StaticResource PanelBrush}" />
        <Setter Property="Foreground" Value="{StaticResource AccentBrush}" />
    </Style>

    <!--  RoundedTextBoxTemplate  -->
    <ControlTemplate x:Key="RoundedTextBoxTemplate" TargetType="TextBox">
        <Border
            VerticalAlignment="Stretch"
            Background="{StaticResource PanelBrush}"
            BorderBrush="{TemplateBinding BorderBrush}"
            BorderThickness="{TemplateBinding BorderThickness}"
            CornerRadius="6">
            <TextBox
                Margin="0"
                Padding="2"
                VerticalAlignment="Center"
                Background="{StaticResource TransparentBrush}"
                BorderThickness="0"
                Foreground="{StaticResource AccentBrush}"
                Text="{Binding Text, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                ToolTip="{Binding Text, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
        </Border>
    </ControlTemplate>
</ResourceDictionary>